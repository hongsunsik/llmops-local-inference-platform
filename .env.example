# Local development: http://127.0.0.1:11434
# Docker Compose: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen3:8b
CODER_MODEL=qwen3-coder:30b
FALLBACK_MODEL=glm-4.7-flash:latest
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_REQUESTS=4

# Enable this when an MLflow tracking server is available (Docker Compose sets it automatically).
MLFLOW_TRACING_ENABLED=false
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=local-llmops-gateway
TRACE_CONTENT_ENABLED=false

# Identifies which rollout track this instance belongs to (surfaced on /health
# and the X-Gateway-Track response header). The Kubernetes canary manifests in
# k8s/ set this to "canary" for the canary Deployment.
GATEWAY_TRACK=stable
